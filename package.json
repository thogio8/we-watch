{
  "name": "we-watch",
  "version": "1.3.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:local": "DATABASE_URL=file:local.db DATABASE_AUTH_TOKEN= next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:e2e": "bash scripts/e2e.sh",
    "format:check": "prettier --check .",
    "dup": "jscpd",
    "deadcode": "knip",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run dup && npm run deadcode && npm run test:coverage && npm run test:e2e",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.4",
    "motion": "^14.6.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "jscpd": "^5.4.2",
    "jsdom": "^30.1.3",
    "knip": "^6.43.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "24.x"
  }
}
