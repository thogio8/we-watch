{
  "name": "we-watch",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:local": "DATABASE_URL=file:local.db DATABASE_AUTH_TOKEN= next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:e2e": "bash scripts/e2e.sh",
    "test:lighthouse": "bash scripts/e2e.sh --config=playwright.lighthouse.config.ts",
    "format:check": "prettier --check .",
    "dup": "jscpd",
    "deadcode": "knip",
    "mutation": "stryker run",
    "ci:checks": "npm run format:check && npm run lint && npm run typecheck && npm run dup && npm run deadcode && npm run test:coverage",
    "ci": "npm run ci:checks && npm run test:e2e",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.19",
    "@libsql/client": "^0.18.0",
    "better-auth": "1.7.19",
    "drizzle-orm": "^0.45.4",
    "motion": "^14.12.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "4.10.2",
    "jscpd": "^5.4.3",
    "jsdom": "^31.0.0",
    "knip": "^6.44.2",
    "lefthook": "^2.2.2",
    "lighthouse": "13.6.0",
    "prettier": "^3.9.10",
    "typescript": "^5",
    "vercel": "65.14.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "ajv@8": "^8.18.0",
    "js-yaml@4": "^4.3.2",
    "minimatch@10": "^10.2.3",
    "path-to-regexp@6": "^6.3.0",
    "path-to-regexp@8": "^8.4.0",
    "smol-toml@1": "^1.9.0",
    "tar@7": "^7.5.21",
    "zod@4": "$zod"
  }
}
