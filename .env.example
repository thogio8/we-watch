TMDB_ACCESS_TOKEN=
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=
# Secret du rafraîchissement quotidien (Vercel Cron), facultatif en local :
# openssl rand -hex 32
CRON_SECRET=
# Secret des sessions Better Auth (32 caractères minimum) :
# openssl rand -hex 32
BETTER_AUTH_SECRET=
# Adresse publique de l'appli : son nom d'hôte sert d'identifiant aux passkeys
BETTER_AUTH_URL=http://localhost:3000
# open = tout le monde peut créer un compte, invite = il faut le code propriétaire
SIGNUP=open
# Code propriétaire (12 caractères minimum), utile seulement avec SIGNUP=invite
OWNER_CODE=
